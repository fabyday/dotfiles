#!/usr/bin/env sh

# the scripting-addition must be loaded manually if
# you are running yabai on macOS Big Sur. Uncomment
# the following line to have the injection performed
# when the config is executed during startup.
#
# for this to work you must configure sudo such that
# it will be able to run the command without password
#
# see this wiki page for information:
#  - https://github.com/koekeishiya/yabai/wiki/Installing-yabai-(latest-release)
#
# base version ref := v7.1.17

sudo yabai --load-sa
yabai -m signal --remove yabai_load_sa >/dev/null 2>&1 || true
yabai -m signal --add label=yabai_load_sa event=dock_did_restart action="sudo yabai --load-sa"

# global settings
yabai -m config mouse_follows_focus          off
yabai -m config window_placement             second_child
yabai -m config window_shadow                on
yabai -m config split_ratio                  0.50
yabai -m config auto_balance                 off

# general space settings
# Keep the space layout as BSP. New windows are stacked onto the focused window
# by a window_created signal; use skhd insert bindings to split manually.
yabai -m config layout                       bsp
yabai -m config top_padding                  8
yabai -m config bottom_padding               36
yabai -m config left_padding                 8
yabai -m config right_padding                8
yabai -m config window_gap                   8
yabai -m config external_bar main:0:0

# Keep each connected display provisioned with 10 Mission Control spaces.
# This runs only on startup/display changes, so it avoids the layout feedback
# loops caused by high-frequency window movement signals.
YABAI_ENSURE_SPACES="$HOME/.config/yabai/lib/ensure-display-spaces.sh"
sh "$YABAI_ENSURE_SPACES"



# space 1: terminals
yabai -m rule --add app="iTerm2" space=d1s1
yabai -m rule --add app="kitty" space=d1s1

# space 2: vscode development
yabai -m rule --add app="^Code$" space=d1s2
yabai -m rule --add app="^Code$" title="Preferences" space=d1s2 manage=off

# space 3: web
yabai -m rule --add app="Google Chrome" space=d1s3

# space 4: GameON



# space 5: stack
yabai -m space d1s5 --layout stack
yabai -m rule --add \
    app="^BDIH Launcher$" \
    space=d1s10 \
    manage=off \

# display 2 slot 4: off-stream and out of the way
yabai -m rule --add app="^Discord$" title="^Discord Updater$" space=d1s4
yabai -m rule --add app="^Discord$" title=".*Discord.*" space=d1s4



yabai -m rule --add app="OBS Studio" space=d2s4
yabai -m rule --add app="OBS.*" space=d2s4
yabai -m rule --add app="Podcasts" space=d2s4
yabai -m rule --add app="^(Electron|Kawaikara.*)$" manage=off



####################################################################
# FULL SCREEN APPS SECTION
####################################################################

# Fullscreen Apps(Examples : Games)
# yabai -m  NTE
# this exe App, will be wine Program.
yabai -m rule --add app=".*\\.exe$" manage=off



# things which create floating children
yabai -m rule --add app="System Settings" manage=off
yabai -m rule --add app="BDIH Launcher*" manage=off
yabai -m rule --add app="Elgato Wave Link" manage=off


# sketchbar


# Border Options
borders active_color=0xff00ff00  width=9.0 &

# Show stack indicators through Hammerspoon stackline when available.
if command -v hs >/dev/null 2>&1; then
    hs -c 'if stackline then stackline.config:set("appearance.showIcons", true); stackline.applyYabaiPadding(true) end' >/dev/null 2>&1 || true
fi

# Automatic window-moving signals are intentionally conservative. New windows
# are stacked only once, and only into the previously focused window on the same
# display and space. Other helpers stay manual to avoid layout feedback loops.
YABAI_AUTO_STACK="$HOME/.config/yabai/lib/auto-stack-window.sh"
sh "$YABAI_AUTO_STACK" save-focus
SKHD_FOCUS_GUARD="$HOME/.config/yabai/lib/skhd-focus-guard.sh"
SKHD_RELOAD="$HOME/.config/skhd/lib/reload.sh"
SKETCHYBAR_UPDATE="$HOME/.config/sketchybar/lib/update_spaces.sh"
SPACE_HISTORY="$HOME/.config/yabai/lib/space-history.sh"
sh "$SPACE_HISTORY" seed

yabai -m signal --remove yabai_auto_stack_focus >/dev/null 2>&1 || true
yabai -m signal --remove yabai_auto_stack_created >/dev/null 2>&1 || true
yabai -m signal --remove yabai_skhd_focus_guard >/dev/null 2>&1 || true
yabai -m signal --remove yabai_skhd_focus_guard_space >/dev/null 2>&1 || true
yabai -m signal --remove yabai_skhd_mode_app_switch >/dev/null 2>&1 || true
yabai -m signal --remove yabai_ensure_display_spaces_added >/dev/null 2>&1 || true
yabai -m signal --remove yabai_ensure_display_spaces_removed >/dev/null 2>&1 || true
yabai -m signal --remove yabai_ensure_display_spaces_changed >/dev/null 2>&1 || true
yabai -m signal --remove yabai_ensure_display_spaces_woke >/dev/null 2>&1 || true
yabai -m signal --remove yabai_space_history >/dev/null 2>&1 || true

yabai -m signal --add label=yabai_auto_stack_focus event=window_focused action="sh $YABAI_AUTO_STACK save-focus"
yabai -m signal --add label=yabai_auto_stack_created event=window_created action="sh $YABAI_AUTO_STACK stack-new"
yabai -m signal --add label=yabai_skhd_focus_guard event=window_focused action="sh $SKHD_FOCUS_GUARD"
yabai -m signal --add label=yabai_skhd_focus_guard_space event=space_changed action="sh $SKHD_FOCUS_GUARD"
yabai -m signal --add label=yabai_skhd_mode_app_switch event=application_front_switched action="sh $SKHD_RELOAD --on-app-switch"
yabai -m signal --add label=yabai_ensure_display_spaces_added event=display_added action="sh $YABAI_ENSURE_SPACES"
yabai -m signal --add label=yabai_ensure_display_spaces_removed event=display_removed action="sh $YABAI_ENSURE_SPACES"
yabai -m signal --add label=yabai_ensure_display_spaces_woke event=system_woke action="sh $YABAI_ENSURE_SPACES"
yabai -m signal --add label=yabai_space_history event=space_changed action="sh $SPACE_HISTORY record \$YABAI_SPACE_INDEX"

yabai -m signal --remove yabai_sketchybar_window_moved >/dev/null 2>&1 || true
for event in window_created window_destroyed space_changed display_added display_removed display_changed; do
    label="yabai_sketchybar_$event"
    yabai -m signal --remove "$label" >/dev/null 2>&1 || true
    yabai -m signal --add label="$label" event="$event" action="sh $SKETCHYBAR_UPDATE"
done

yabai -m signal --remove yabai_fit_window_created >/dev/null 2>&1 || true
yabai -m signal --remove yabai_fit_window_resized >/dev/null 2>&1 || true
yabai -m signal --remove yabai_fit_display_changed >/dev/null 2>&1 || true
yabai -m signal --remove yabai_fit_display_resized >/dev/null 2>&1 || true
yabai -m signal --remove yabai_fit_system_woke >/dev/null 2>&1 || true

yabai -m signal --remove yabai_state_save_window_created >/dev/null 2>&1 || true
yabai -m signal --remove yabai_state_save_window_destroyed >/dev/null 2>&1 || true
yabai -m signal --remove yabai_state_save_window_moved >/dev/null 2>&1 || true
yabai -m signal --remove yabai_state_save_window_resized >/dev/null 2>&1 || true
yabai -m signal --remove yabai_state_save_window_focused >/dev/null 2>&1 || true
yabai -m signal --remove yabai_state_save_space_changed >/dev/null 2>&1 || true
yabai -m signal --remove yabai_state_restore_display_added >/dev/null 2>&1 || true
yabai -m signal --remove yabai_state_restore_display_removed >/dev/null 2>&1 || true
yabai -m signal --remove yabai_state_restore_display_resized >/dev/null 2>&1 || true
yabai -m signal --remove yabai_state_restore_display_changed >/dev/null 2>&1 || true
yabai -m signal --remove yabai_state_restore_system_woke >/dev/null 2>&1 || true
