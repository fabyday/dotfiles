# skhd modal controls for yabai.
#
# Modes:
# - default: everyday navigation
# - window: window placement/actions
# - resize: resize the focused window
# - relocate: stack windows, mark BSP insertion, choose new-window mode
# - display: displays and workspaces

:: default : sh ~/.config/sketchybar/lib/skhd_mode.sh normal
:: window : sh ~/.config/sketchybar/lib/skhd_mode.sh window
:: resize : sh ~/.config/sketchybar/lib/skhd_mode.sh resize
:: relocate : sh ~/.config/sketchybar/lib/skhd_mode.sh relocate
:: display : sh ~/.config/sketchybar/lib/skhd_mode.sh display; sh ~/.config/yabai/lib/display-space.sh select-display current



# mode entry
cmd + alt - u ; window
cmd + alt - i ; resize
cmd + alt - o ; relocate
cmd + alt - p ; display
cmd + alt - escape ; default
window < cmd + alt - escape ; default
resize < cmd + alt - escape ; default
relocate < cmd + alt - escape ; default
display < cmd + alt - escape ; default
display < cmd + alt - p ; default

cmd + alt - y : \
    if pgrep -x yabai >/dev/null; then \
        yabai --stop-service; \
    else \
        yabai --start-service; \
    fi
cmd + alt - r : yabai --restart-service


# default: focus and stack navigation
ctrl - h : yabai -m window --focus west || yabai -m window --focus recent
ctrl - j : yabai -m window --focus south || yabai -m window --focus recent
ctrl - k : yabai -m window --focus north || yabai -m window --focus recent
ctrl - l : yabai -m window --focus east || yabai -m window --focus recent

default, window, resize, relocate, display < cmd + shift - w : yabai -m window --focus stack.prev || yabai -m window --focus stack.last
default, window, resize, relocate, display < cmd + shift - e : yabai -m window --focus stack.next || yabai -m window --focus stack.first

cmd + fn - g : open -na "Google Chrome"
cmd + fn - t : open -na "iTerm"

# default: useful global toggles
shift + alt - b : hs -c 'stackline.config:toggle("appearance.showIcons"); stackline.applyYabaiPadding()'
shift + alt - 0 : yabai -m space --balance

# resize mode
resize < h : yabai -m window --resize left:-20:0
resize < j : yabai -m window --resize bottom:0:20
resize < k : yabai -m window --resize top:0:-20
resize < l : yabai -m window --resize right:20:0

resize < shift - h : yabai -m window --resize left:20:0
resize < shift - j : yabai -m window --resize bottom:0:-20
resize < shift - k : yabai -m window --resize top:0:20
resize < shift - l : yabai -m window --resize right:-20:0

resize < 0 : yabai -m space --balance
resize < escape ; default

# relocate mode: stack the focused window onto a directional neighbor.
# Shift + direction marks the next BSP insertion position instead.
relocate < h : sh ~/.config/yabai/lib/stack-into-direction.sh west
relocate < j : sh ~/.config/yabai/lib/stack-into-direction.sh south
relocate < k : sh ~/.config/yabai/lib/stack-into-direction.sh north
relocate < l : sh ~/.config/yabai/lib/stack-into-direction.sh east
relocate < shift - h : yabai -m window --insert west
relocate < shift - j : yabai -m window --insert south
relocate < shift - k : yabai -m window --insert north
relocate < shift - l : yabai -m window --insert east
relocate < s : yabai -m window --insert stack
relocate < e : yabai -m window --toggle split
relocate < shift - s : sh ~/.config/yabai/lib/new-window-mode.sh set stack
relocate < shift - b : sh ~/.config/yabai/lib/new-window-mode.sh set bsp
relocate < escape ; default

# window mode: move/swap/stack/toggle focused window
window < h : yabai -m window --swap west
window < j : yabai -m window --swap south
window < k : yabai -m window --swap north
window < l : yabai -m window --swap east

window < shift - h : yabai -m window --warp west
window < shift - j : yabai -m window --warp south
window < shift - k : yabai -m window --warp north
window < shift - l : yabai -m window --warp east

window < alt - h : yabai -m window --stack west
window < alt - j : yabai -m window --stack south
window < alt - k : yabai -m window --stack north
window < alt - l : yabai -m window --stack east
window < e : sh ~/.config/yabai/lib/unstack-window.sh east

window < a : yabai -m window --move rel:-20:0
window < s : yabai -m window --move rel:0:20
window < d : yabai -m window --move rel:20:0
window < w : yabai -m window --move rel:0:-20

window < f : yabai -m window --toggle float; yabai -m window --grid 4:4:1:1:2:2
window < z : yabai -m window --toggle zoom-parent
window < shift - z : yabai -m window --toggle zoom-fullscreen
window < p : yabai -m window --toggle pip
window < t : yabai -m window --toggle sticky
window < x : yabai -m window --toggle shadow
window < 0 : yabai -m space --balance
window < 1 : sh ~/.config/yabai/lib/root-split-ratio.sh 0.5
window < 2 : sh ~/.config/yabai/lib/root-split-ratio.sh 0.6
window < 3 : sh ~/.config/yabai/lib/root-split-ratio.sh 0.7
window < 4 : sh ~/.config/yabai/lib/root-split-ratio.sh 0.8
window < escape ; default

# display mode: focus spaces/displays or send windows there
display < h : sh ~/.config/yabai/lib/display-space.sh select-display prev
display < l : sh ~/.config/yabai/lib/display-space.sh select-display next
# Each display has its own ten-entry workspace history.
display < j : sh ~/.config/yabai/lib/space-history.sh prev
display < k : sh ~/.config/yabai/lib/space-history.sh next

display < shift - h : sh ~/.config/yabai/lib/display-space.sh move-window-display prev
display < shift - l : sh ~/.config/yabai/lib/display-space.sh move-window-display next
display < alt - 1 : sh ~/.config/yabai/lib/display-space.sh move-window-display 1
display < alt - 2 : sh ~/.config/yabai/lib/display-space.sh move-window-display 2
display < alt - 3 : sh ~/.config/yabai/lib/display-space.sh move-window-display 3
display < alt - 4 : sh ~/.config/yabai/lib/display-space.sh move-window-display 4
display < alt - 5 : sh ~/.config/yabai/lib/display-space.sh move-window-display 5
display < alt - 6 : sh ~/.config/yabai/lib/display-space.sh move-window-display 6
display < shift - j : yabai -m window --space prev; yabai -m space --focus prev
display < shift - k : yabai -m window --space next; yabai -m space --focus next

display < 1 : sh ~/.config/yabai/lib/display-space.sh focus 1
display < 2 : sh ~/.config/yabai/lib/display-space.sh focus 2
display < 3 : sh ~/.config/yabai/lib/display-space.sh focus 3
display < 4 : sh ~/.config/yabai/lib/display-space.sh focus 4
display < 5 : sh ~/.config/yabai/lib/display-space.sh focus 5
display < 6 : sh ~/.config/yabai/lib/display-space.sh focus 6
display < 7 : sh ~/.config/yabai/lib/display-space.sh focus 7
display < 8 : sh ~/.config/yabai/lib/display-space.sh focus 8
display < 9 : sh ~/.config/yabai/lib/display-space.sh focus 9
display < 0 : sh ~/.config/yabai/lib/display-space.sh focus 10

display < shift - 1 : sh ~/.config/yabai/lib/display-space.sh move-window 1
display < shift - 2 : sh ~/.config/yabai/lib/display-space.sh move-window 2
display < shift - 3 : sh ~/.config/yabai/lib/display-space.sh move-window 3
display < shift - 4 : sh ~/.config/yabai/lib/display-space.sh move-window 4
display < shift - 5 : sh ~/.config/yabai/lib/display-space.sh move-window 5
display < shift - 6 : sh ~/.config/yabai/lib/display-space.sh move-window 6
display < shift - 7 : sh ~/.config/yabai/lib/display-space.sh move-window 7
display < shift - 8 : sh ~/.config/yabai/lib/display-space.sh move-window 8
display < shift - 9 : sh ~/.config/yabai/lib/display-space.sh move-window 9
display < shift - 0 : sh ~/.config/yabai/lib/display-space.sh move-window 10

display < escape ; default
